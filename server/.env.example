# Server Port
PORT=5001

# Prisma Database Connections (Neon / PostgreSQL)
# Do NOT use quotes around values.
DATABASE_URL=
DIRECT_URL=

# Gemini AI (Backend API Key)
GEMINI_API_KEY=

# Firebase Admin SDK Configuration
# The path to your serviceAccountKey.json relative to the server root
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
