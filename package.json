{
  "name": "warmpath-root",
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install && cd server && npm install express cors dotenv prisma @prisma/client && npx prisma generate && cd ../warm-path && npm install",
    "start:client": "cd warm-path && npm run dev -- --open",
    "start:server": "cd server && npm run dev",
    "db:ui": "cd server && npx prisma studio",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "dev:all": "concurrently \"npm run start:server\" \"npm run start:client\" \"npm run db:ui\"",
    "build:client": "cd warm-path && npm run build",
    "lint:client": "cd warm-path && npm run lint",
    "preview:client": "cd warm-path && npm run preview"
  },
  "dependencies": {
    "@prisma/client": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "concurrently": "^8.2.2",
    "prisma": "^7.4.1"
  },
  "overrides": {
    "eslint": "^10.0.1",
    "hono": "^4.12.7",
    "@hono/node-server": "^1.19.11",
    "lodash": "^4.17.22"
  }
}
